VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tendencias: período en días para calcular consumo diario promedio (default 30)
TRENDS_PERIOD_DAYS=30

# Asistente virtual: LLM (OpenAI-compatible)
# Para Ollama local: http://localhost:11434/v1
# Para Ollama en servidor: http://<ip-del-servidor>:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b

# Proveedor por defecto (groq | zen)
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=

# OpenCode Zen (https://opencode.ai/auth)
ZEN_API_KEY=
